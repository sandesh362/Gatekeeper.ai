# Application
APP_NAME=gatekeeper
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://gatekeeper:gatekeeper@localhost:5432/gatekeeper

# LLM Provider API Keys (never commit real keys)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Security (Phase 3+)
SECRET_KEY=change-me-in-production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Vector DB (Phase 3+)
CHROMA_HOST=localhost
CHROMA_PORT=8001
