# Application
APP_NAME=gatekeeper
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://gatekeeper:gatekeeper@localhost:5432/gatekeeper

# LLM Provider API Keys (never commit real keys)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Security (Phase 3+)
SECRET_KEY=change-me-in-production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Vector DB (Phase 3)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Detection engine (Phase 3)
DETECTION_LLM_JUDGE_ENABLED=true
DETECTION_LLM_JUDGE_PROVIDER=anthropic
DETECTION_LLM_JUDGE_MODEL=claude-3-haiku-20240307
DETECTION_OLLAMA_BASE_URL=http://localhost:11434
DETECTION_OLLAMA_MODEL=llama3.2

DETECTION_WEIGHT_RULES=0.3
DETECTION_WEIGHT_EMBEDDING=0.25
DETECTION_WEIGHT_LLM_JUDGE=0.3
DETECTION_WEIGHT_HEURISTICS=0.15

DETECTION_EMBEDDING_THRESHOLD_HIGH=0.85
DETECTION_EMBEDDING_THRESHOLD_MEDIUM=0.7

DETECTION_PASS_THRESHOLD=40
DETECTION_BLOCK_THRESHOLD=75
